# Ecotecplast ColorHub — environment variables
#
# Copy to `.env` (remote/hosted) and/or `.env.local` (local Supabase Docker).
# Never commit real keys; `.env` and `.env*.local` are gitignored.

# ── Local Supabase (Docker) ────────────────────────────────────────────────
# `pnpm supabase:start` then copy the URL + keys from
# `pnpm supabase:status -o env`. Ports match supabase/config.toml (563xx).
# Already written to the gitignored `.env.local`.
# PUBLIC_SUPABASE_URL="http://127.0.0.1:56321"
# PUBLIC_SUPABASE_PUBLISHABLE_KEY="<from `pnpm supabase:status -o env`>"
# SUPABASE_SECRET_KEY="<from `pnpm supabase:status -o env`>"

# ── Hosted Supabase (DEV / PROD) ───────────────────────────────────────────
# Project Settings -> Data API.
PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Safe for the browser.
PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only — never exposed to the client.
SUPABASE_SECRET_KEY="sb_secret_..."
